{
  "name": "rubies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:web": "tsc -p tsconfig.json && vite build --base /Rubies/ --outDir dist-web",
    "preview:web": "vite preview --base /Rubies/ --outDir dist-web",
    "preview": "vite preview",
    "test": "vitest run",
    "build:bible": "node scripts/build-kjv.mjs",
    "desktop": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win",
    "desktop:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@mantine/tiptap": "^9.8.1",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-blockquote": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.15.4",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "lucide-react": "^1.74.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "description": "Sermon note taking with the King James Bible",
  "author": "Rubies",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.rubies.sermonnotes",
    "productName": "Rubies",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rubies"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    }
  }
}
